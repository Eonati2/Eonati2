# Copy to minimax/.env and fill in. Never commit the real file.
MINIMAX_API_KEY=your_api_key_from_platform.minimax.io
# Only needed if /files/retrieve rejects calls without it:
MINIMAX_GROUP_ID=
# Override if you are on the CN endpoint or US-West:
